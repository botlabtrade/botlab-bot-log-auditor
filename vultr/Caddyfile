# SITE_ADDRESS comes from docker-compose: your DOMAIN (automatic HTTPS via Let's Encrypt / ZeroSSL)
# or ":80" (plain HTTP on the server IP) when DOMAIN is empty.
{$SITE_ADDRESS} {
	encode gzip
	request_body {
		max_size 6MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy app:8000
}
