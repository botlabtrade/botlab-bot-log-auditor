# Copy to vultr/.env on the server (cp .env.example .env) and fill it in with nano.
# NEVER commit .env and never paste keys into chat. All values are optional except where noted.

# --- Public address -------------------------------------------------------
# Your domain (e.g. auditor.example.com) whose DNS A record points at the server IP.
# Leave empty to serve plain HTTP on port 80 at http://<server-ip>/
DOMAIN=
# Public URL of the app (used for PayPal return links): https://<DOMAIN> or http://<server-ip>
PUBLIC_BASE_URL=

# --- LLM: Vultr Serverless Inference (OpenAI-compatible) -------------------
# mock = offline demo (no key needed). For the real agent use openai_compatible (or the alias vultr).
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.vultrinference.com/v1
# Inference API key from the Vultr portal (Serverless > Inference > your subscription). Not your account API key.
LLM_API_KEY=
# A chat model id returned by GET https://api.vultrinference.com/v1/models (check on the day)
LLM_MODEL=

# --- Agent loop limits ----------------------------------------------------
AGENT_MAX_STEPS=4
AGENT_STEP_TIMEOUT_S=6
AGENT_MAX_OUTPUT=4000
AGENT_TOTAL_BUDGET_S=90
# Max audits running at the same time (protects inference credits)
MAX_RUNNING_JOBS=3

# --- Sandbox runner (set automatically by docker-compose; change only for debugging)
# RUNNER_TOKEN=          optional shared secret between app and runner
# RUNNER_FALLBACK_LOCAL= leave empty in production (fail closed if the runner is down)

# --- Payments (PayPal sandbox; not needed for the Vultr event) -------------
PAYPAL_MODE=disabled
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
