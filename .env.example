# Copy to .env (never commit it) or export these in your shell. All optional.
# LLM_PROVIDER=mock            # mock | anthropic | openai_compatible (auto-detected if unset)
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=https://api.vultrinference.com/v1
# LLM_API_KEY=
# PAYPAL_MODE=sandbox          # sandbox | mock | disabled
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PRO_PRICE_USD=4.99
# PUBLIC_BASE_URL=http://127.0.0.1:8000
# HOST=127.0.0.1
# PORT=8000
